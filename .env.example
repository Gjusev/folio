# --- Database (docker compose provides this one) ---
DATABASE_URL=postgres://folio:folio@localhost:5432/folio
# Required by docker compose (db credential and web's DATABASE_URL).
# MUST match the password the pgdata volume was initialized with.
POSTGRES_PASSWORD=folio

# --- Public URL ---
# The origin users reach the app at (used for absolute links such as the
# Open Graph image). Example: https://folio.example.org
APP_URL=

# --- E-mail (optional; empty = off, the default) ---
# Enables password reset by e-mail and invitation e-mails. Requires APP_URL:
# links are built only from it. `pnpm reset-password` keeps working either way.
# Either one URL (special characters in user/password must be URL-encoded):
#   SMTP_URL=smtps://folio%40example.org:secret@smtp.example.org:465
SMTP_URL=
# ...or discrete values, taken verbatim (recommended when the password has
# @ # : / ? %). SMTP_URL wins if both are set. 465 = implicit TLS, 587 = STARTTLS.
# A literal $ must be written $$ in Compose env files (pnpm dev takes it
# verbatim); see docs/deployment.md.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender. Empty = SMTP_USER if it is an address, else no-reply@<APP_URL host>.
SMTP_FROM=

# --- Accounts ---
# 1 = self-registration open (default). Set 0 on public deployments to close it;
# existing accounts keep logging in.
ALLOW_REGISTRATION=1

# --- LaTeX compiler service (shared secret between web and compiler) ---
COMPILER_URL=http://127.0.0.1:3001
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COMPILER_TOKEN=change-me-to-a-long-random-string

# --- Live collaboration (optional; empty = off, the default) ---
# WebSocket relay the EDITOR'S BROWSER connects to (not the server), so the
# host must be reachable from the user's machine.
#   dev:    start the relay and set COLLAB_URL=ws://127.0.0.1:3002
#           (docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build collab)
#   prod:   put the relay behind a same-origin wss:// reverse proxy, or extend
#           the CSP connect-src in next.config.ts (it only allows 'self').
# Leave empty for the exact pre-collab behaviour.
COLLAB_URL=
# HMAC key for relay tokens. Unset falls back to COMPILER_TOKEN (single-secret
# deployments); the relay container must be given the same value.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COLLAB_SECRET=

# --- AI: any OpenAI-compatible endpoint (vLLM, Ollama, Mistral, DeepSeek, OpenAI, OpenRouter...) ---
# Leave LLM_BASE_URL empty to disable AI features.
# Ollama:   LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen3:4b
# Mistral:  LLM_BASE_URL=https://api.mistral.ai/v1    LLM_MODEL=mistral-small-latest
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- AI provider profiles (Settings page) ---
# Secret used to encrypt provider API keys at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates stored keys: users must re-enter them.
LLM_CREDENTIALS_KEY=

# --- BYOK (bring your own key) ---
# While true (default), the LLM_* key above is available to EVERY user of this
# instance (fine for single-user self-hosting). On a shared instance set it to
# false: nobody uses the .env key and each user adds their own provider in
# Settings (keys are per-user and encrypted at rest).
# LLM_ENV_SHARED=true

# --- Local LLM runtimes (Ollama & friends) ---
# Base URLs that resolve to loopback/private IPs are rejected by default (SSRF
# guard). Set to 1 if this host actually runs a local model server, and list the
# ports it may be reached on (default: 11434, Ollama's).
# LLM_ALLOW_LOCAL=1
# LLM_ALLOWED_LOCAL_PORTS=11434

# --- Scholarly search: OpenAlex ---
# Optional, recommended: your contact e-mail for OpenAlex's polite pool.
OPENALEX_MAILTO=
# Optional: a free OpenAlex API key ($1/day own budget) so the instance is
# not throttled by the shared keyless daily pool. Get one at
# https://openalex.org/settings/api
OPENALEX_API_KEY=

# --- Grammar checking: LanguageTool (optional) ---
# Empty = off. Start the server with `docker compose --profile grammar up -d languagetool`
# and set http://127.0.0.1:8010 (pnpm dev) or http://languagetool:8010 (web container).
LANGUAGETOOL_URL=

# Optional: link to the repository shown in the landing footer (hidden if empty)
# NEXT_PUBLIC_REPO_URL=https://github.com/your-org/folio
