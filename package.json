{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mts",
    "dev": "next dev",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "reset-password": "node --env-file-if-exists=.env scripts/reset-password.mts",
    "services:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "services:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build db compiler",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@react-sigma/core": "^6.0.0",
    "@react-sigma/layout-forceatlas2": "^6.0.0",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-pdf": "^11.0.0",
    "react-resizable-panels": "^4.17.0",
    "server-only": "^0.0.1",
    "sigma": "^4.0.4",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  }
}
